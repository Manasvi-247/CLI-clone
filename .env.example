# Get free keys at https://aistudio.google.com/apikey

# Single-key mode (simplest):
GEMINI_API_KEY=your_gemini_api_key_here

# Multi-key mode (recommended for demos): comma-separated, no spaces.
# When set, this overrides GEMINI_API_KEY. The agent rotates to the next
# key automatically on 429/503 so a single rate-limited key doesn't stall the run.
# GEMINI_API_KEYS=key1,key2,key3

# Optional: override default model (default: gemini-flash-latest).
# MODEL=gemini-2.5-flash
